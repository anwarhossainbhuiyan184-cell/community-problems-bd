# Copy this file to .env and fill in your Supabase project details.
# These values are safe to expose in the browser: the anon key is protected by
# Row Level Security. Never put a service-role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
